.env
.ocr_cache/
logs/
docs/
# Real dossiers never enter the repository. The three synthetic cases below do,
# because testing/checks reads them and a fresh clone must be able to run the
# suite. Regenerate them with: python3 samples/make_samples.py
# Anything else under samples/ - a real dossier put in samples/case_that/, say -
# stays out. The generated SQLite is excluded too: it is rebuilt from its script.
samples/*
!samples/make_samples.py
!samples/case_demo/
!samples/case_nhieu_ky_bctc/
!samples/case_thieu_ho_so/
!samples/dummy_db/
samples/dummy_db/*.sqlite
__pycache__/
*.pyc
.DS_Store
