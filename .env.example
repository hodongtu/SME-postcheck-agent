# --- Gateway ---
OPENAI_API_KEY=
OPENAI_API_BASE=

# --- Model cho từng pass trích xuất (tên pass theo SME_creditmemo) ---
MODEL_FINANCIAL_STATEMENT=
MODEL_PROPOSAL=
MODEL_SITEVISIT=
MODEL_CIC_S10A=
MODEL_CIC_R20=
# Hai đoạn Nhận định ở BRD 2.2 và 2.4
MODEL_COMMENTARY=

# --- Giới hạn gọi ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_CLIENT_MAX_RETRIES=1

# --- OCR (chỉ dùng khi hồ sơ có PDF scan) ---
OCR_LANG=vie+eng
OCR_DPI=300
OCR_MAX_WORKERS=8
OCR_CACHE_DIR=.ocr_cache
OCR_PREPROCESS=1
OCR_DESKEW=1
OCR_LAYOUT=1
